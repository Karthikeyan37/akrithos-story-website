{
  "name": "akrithos-standalone-marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "tokens:check": "node scripts/verify-foundation.mjs",
    "verify": "npm run lint && npm run typecheck && npm run tokens:check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.186.0",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  }

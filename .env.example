NEXT_PUBLIC_SITE_URL=https://akrithos.com
NEXT_PUBLIC_GHL_PORTAL_URL=https://learn.akrithos.com/
NEXT_PUBLIC_GHL_DIAGNOSTIC_FORM_ID=NF6k2MmqcnTNqAfG3Fxd
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/alex-buriak/akrithos-ai-scoping-call
NEXT_PUBLIC_FOUNDING_CHECKOUT_URL=https://link.fastpaydirect.com/payment-link/6a74dc5a50f272ef3a73c519
NEXT_PUBLIC_SINGLE_SESSION_CHECKOUT_URL=https://link.fastpaydirect.com/payment-link/6a7a014ac8cc9a2ce7267306
NEXT_PUBLIC_MONTHLY_CHECKOUT_URL=https://link.fastpaydirect.com/payment-link/6a830bf573c7ff66b05e890a
NEXT_PUBLIC_CONTACT_EMAIL=info@akrithos.com

# Server-side only (never prefix with NEXT_PUBLIC_). Powers the
# Ask Akrithos guide and the workflow blueprint. Without it, both show a
# labelled preview instead of erroring.
ANTHROPIC_API_KEY=
# For a fast, low-cost website guide, for example claude-haiku-5-5. Check the
# current model names at https://docs.claude.com before setting this.
ANTHROPIC_MODEL=
# Optional — only needed if your API key returns an "invalid_request_error"
# about not being scoped to a workspace. Find this in console.anthropic.com
# under your organization/workspace settings if that error occurs.
ANTHROPIC_WORKSPACE_ID=

# Guide answers per day per server instance (cost cap). Default 600.
ASK_DAILY_LIMIT=

# GoHighLevel (server-side only). See GHL-SETUP.md.
# A Private Integration token with the contacts.write scope, and the sub-account's location id.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Optional: map our fields to your custom field ids for personalised emails, as JSON.
# {"ak_level":"","ak_score":"","ak_first_agent":"","ak_path":"","ak_hours_year":"","ak_industry":""}
GHL_FIELD_IDS=
# 64 random characters (openssl rand -hex 32). Lets a known visitor's later actions tag their contact.
LEAD_SIGNING_SECRET=
